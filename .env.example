# SQLite DB path. The path is relative to prisma/schema.prisma → resolves to ./data/lab.db
DATABASE_URL="file:./data/lab.db"

# Hub identity for SSH back-connect (workers SSH to here for the transcribe template).
# Leave blank to auto-derive from `tailscale ip -4` at runtime.
HUB_TAILSCALE_HOST=""
HUB_SSH_USER=""

# WebSocket terminal server port
TERMINAL_PORT=3002

# Metrics sampler cadence (seconds) and retention (days)
SAMPLE_INTERVAL_SEC=60
SAMPLE_RETENTION_DAYS=7

# Optional: where the existing mentoring-transcripts coordinator lives (adapter
# in src/lib/transcripts.ts reads from here). Safe to leave unset if you don't
# use the transcription template.
TRANSCRIPTS_ROOT=""
